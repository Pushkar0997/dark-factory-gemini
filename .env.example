# Copy to .env (git-ignored). Needed only for Google ADK (Gemini) seats.

# Band endpoints
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Gemini access — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Lineup used by `factory-seat` when --lineup is omitted (factory/lineups.toml)
FACTORY_LINEUP=hybrid
# Absolute root the Gemini workspace tools may touch (required for implementer/reviewer)
FACTORY_WORKSPACE=

# Rate limiting / retry (defaults shown; see FACTORY.md "Rate limiting")
FACTORY_MAX_RETRIES=6
FACTORY_INITIAL_BACKOFF=5
FACTORY_BACKOFF_FACTOR=2
FACTORY_MAX_BACKOFF=90
FACTORY_JITTER=0.25
FACTORY_TURN_DELAY=2
